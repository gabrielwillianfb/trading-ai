# ==========================================
# TRADING AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Trading Mode: "paper" (default) or "testnet"
# WARNING: Production mode is strictly forbidden and unsupported.
TRADING_MODE=paper

# Application
APP_NAME=TradingAI
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/trading_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/trading_ai

# Exchange Configuration (Testnet / Sandbox only)
EXCHANGE_ID=binance_testnet
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET_BASE_URL=https://testnet.binance.vision/api

# Target Assets & Timeframes
SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAME=15m
TIMEFRAMES=5m,15m,1h,4h

# Risk Management Settings
MAX_RISK_PER_TRADE_PCT=0.005    # 0.5% max risk per trade
MAX_DAILY_LOSS_PCT=0.02         # 2.0% max daily loss kill-switch
MAX_DRAWDOWN_PCT=0.10           # 10.0% max total drawdown kill-switch
MAX_OPEN_POSITIONS=1            # Max concurrent open positions
MAX_POSITION_SIZE_PCT=0.10      # 10.0% max portfolio allocation per position
DEFAULT_STOP_LOSS_PCT=0.01      # 1.0% stop loss
DEFAULT_TAKE_PROFIT_PCT=0.02    # 2.0% take profit

# Machine Learning Settings
TARGET_RETURN_PCT=0.005         # 0.5% target return for classification
PREDICTION_HORIZON=12           # 12 candles ahead for label evaluation
PROBABILITY_BUY_THRESHOLD=0.65  # Min probability to trigger BUY signal
PROBABILITY_SELL_THRESHOLD=0.65 # Min probability to trigger SELL signal
